<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- Flashlight Toggle Container (Holds OFF and ON state layouts) -->
    <FrameLayout
        android:id="@+id/widget_torch_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp">

        <!-- OFF State Button (Default) -->
        <LinearLayout
            android:id="@+id/widget_torch_off_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_btn_bg">

            <ImageView
                android:id="@+id/widget_torch_off_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_widget_torch"
                android:contentDescription="Toggle Flashlight" />

            <TextView
                android:id="@+id/widget_torch_off_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLASHLIGHT"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/widget_torch_off_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="#94A3B8"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- ON State Button -->
        <LinearLayout
            android:id="@+id/widget_torch_on_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:background="@drawable/widget_btn_torch_on">

            <ImageView
                android:id="@+id/widget_torch_on_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_widget_torch_on"
                android:contentDescription="Toggle Flashlight" />

            <TextView
                android:id="@+id/widget_torch_on_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLASHLIGHT"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/widget_torch_on_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIGHT ON"
                android:textColor="#000000"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Emergency SOS Distress Button -->
    <LinearLayout
        android:id="@+id/widget_sos_btn"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_btn_bg">

        <ImageView
            android:id="@+id/widget_sos_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_widget_sos"
            android:contentDescription="Emergency SOS" />

        <TextView
            android:id="@+id/widget_sos_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOS BEACON"
            android:textColor="#FF4D4D"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/widget_sos_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISTRESS"
            android:textColor="#94A3B8"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
