<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- Flashlight Toggle Section -->
    <LinearLayout
        android:id="@+id/widget_torch_btn"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_btn_bg">

        <ImageView
            android:id="@+id/widget_torch_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_widget_torch"
            android:contentDescription="Toggle Flashlight" />

        <TextView
            android:id="@+id/widget_torch_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FLASHLIGHT"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/widget_torch_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFF"
            android:textColor="#94A3B8"
            android:textSize="9sp" />
    </LinearLayout>

    <View
        android:layout_width="6dp"
        android:layout_height="match_parent" />

    <!-- Open App / SOS Section -->
    <LinearLayout
        android:id="@+id/widget_sos_btn"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_btn_bg">

        <ImageView
            android:id="@+id/widget_sos_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_widget_sos"
            android:contentDescription="Emergency SOS" />

        <TextView
            android:id="@+id/widget_sos_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOS BEACON"
            android:textColor="#FF4D4D"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/widget_sos_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISTRESS"
            android:textColor="#94A3B8"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
